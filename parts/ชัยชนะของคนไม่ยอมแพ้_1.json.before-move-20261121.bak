{
    "story":  "ชัยชนะของคนไม่ยอมแพ้",
    "part":  "1",
    "scene":  "บ้านครอบครัวอัมพร",
    "wav":  "{DESKTOP}/ชัยชนะของคนไม่ยอมแพ้/เสียงที่ตัดแล้ว/ท่อน1.wav",
    "from":  "{DRIVE}/ชัยชนะของคนไม่ยอมแพ้/ฉาก/บ้านของครอบครัวอำพร (ค่อนข้างยากจน) ตอนสร้างใหม่.iProject",
    "project":  "{SAVE}/ชัยชนะของคนไม่ยอมแพ้/GPT_ท่อน1_20261120.iProject",
    "video":  "{VIDEO}/ชัยชนะของคนไม่ยอมแพ้/GPT_ท่อน1_20261120.mp4",
    "lines":  [
                  {
                      "t":  [
                                0,
                                19.8
                            ],
                      "who":  "บรรยาย",
                      "text":  "อัมพร หรือแดง เป็นลูกสาวคนโตของครอบครัว ฐานะทางบ้านของเธอไม่ได้ร่ำรวย",
                      "about":  [
                                    "อัมพร",
                                    "ครอบครัว"
                                ]
                  },
                  {
                      "t":  [
                                19.8,
                                27.76
                            ],
                      "who":  "บรรยาย",
                      "text":  "เพราะพ่อแม่มีอาชีพรับจ้างทั่วไป ทั้งสองทำงานหนักเพื่อเลี้ยงดูลูกทั้งสี่คน",
                      "about":  [
                                    "พ่ออัมพร",
                                    "แม่อัมพร"
                                ]
                  },
                  {
                      "t":  [
                                27.76,
                                36.4
                            ],
                      "who":  "บรรยาย",
                      "text":  "แม้จะขยัน ไม่สูบบุหรี่ ไม่ดื่มเหล้า แต่ด้วยความที่มีลูกหลายคน และเรียนไม่สูง",
                      "about":  [
                                    "พ่ออัมพร",
                                    "แม่อัมพร"
                                ]
                  },
                  {
                      "t":  [
                                36.4,
                                43.76
                            ],
                      "who":  "บรรยาย",
                      "text":  "งานที่ทำเพื่อสร้างรายได้ จึงเป็นเพียงงานรับจ้าง และงานใช้แรงงานทั่วไป",
                      "about":  [
                                    "พ่ออัมพร",
                                    "แม่อัมพร"
                                ]
                  },
                  {
                      "t":  [
                                43.76,
                                51.48
                            ],
                      "who":  "บรรยาย",
                      "text":  "แค่พอกินพอใช้ พอค่าเล่าเรียนของลูกเท่านั้น แต่ไม่พอเหลือเก็บเป็นเงินออม",
                      "about":  [
                                    "ครอบครัว"
                                ]
                  },
                  {
                      "t":  [
                                51.48,
                                56.2
                            ],
                      "who":  "บรรยาย",
                      "text":  "อัมพรเห็นพ่อแม่ทำงานมาตั้งแต่เธอยังเด็ก ดังนั้น",
                      "about":  [
                                    "พ่ออัมพร",
                                    "แม่อัมพร",
                                    "อัมพร"
                                ]
                  },
                  {
                      "t":  [
                                56.2,
                                61.78
                            ],
                      "who":  "บรรยาย",
                      "text":  "พอเธอโตพอที่จะช่วยพ่อแม่ได้ เธอก็จะช่วยทั้งสองทำงาน",
                      "about":  [
                                    "อัมพร"
                                ]
                  },
                  {
                      "t":  [
                                61.78,
                                66.13
                            ],
                      "who":  "บรรยาย",
                      "text":  "โดยไม่ปริปากบ่น แรก ๆ ก็ทำงานบ้าน",
                      "about":  [
                                    "อัมพร"
                                ]
                  }
              ],
