{
 "story": "ชัยชนะของคนไม่ยอมแพ้",
 "part": "3",
 "scene": "โรงทำอิฐมอญ",
 "wav": "{DESKTOP}/ชัยชนะของคนไม่ยอมแพ้/เสียงที่ตัดแล้ว/ท่อน3.wav",
 "from": "{DRIVE}/ชัยชนะของคนไม่ยอมแพ้/ฉาก/ที่ทำงาน (โรงทำอิฐมอญ).iProject",
 "project": "{SAVE}/ชัยชนะของคนไม่ยอมแพ้/ท่อน3_โรงอิฐ_20261121.iProject",
 "video": "{VIDEO}/ชัยชนะของคนไม่ยอมแพ้/GPT_ท่อน3_20261121.mp4",
 "lines": [
  {
   "t": [
    0,
    5.3
   ],
   "who": "บรรยาย",
   "text": "เรียกว่าการช่วยพ่อแม่ ทำงานที่โรงอิฐขนาดเล็กแห่งนี้"
  },
  {
   "t": [
    5.3,
    9.3
   ],
   "who": "บรรยาย",
   "text": "ทำให้อัมพรมีความรู้เรื่องอิฐพอสมควรทีเดียว"
  },
  {
   "t": [
    9.3,
    16.3
   ],
   "who": "บรรยาย",
   "text": "นอกจากนี้ เธอก็ยังรับจ้างทำงานอื่นๆ ทั่วไป แล้วแต่ใครจะจ้าง"
  },
  {
   "t": [
    16.3,
    22.0
   ],
   "who": "บรรยาย",
   "text": "ทั้งรับจ้างถากถางหญ้าในสวน หรือแม้แต่รับจ้างเสิร์ฟอาหาร"
  },
  {
   "t": [
    22.0,
    27.5
   ],
   "who": "บรรยาย",
   "text": "ขึ้นชื่อว่าเป็นงานสุจริต ที่ทำแล้วได้เงินมากินใช้ในครอบครัว"
  },
  {
   "t": [
    27.5,
    31.5
   ],
   "who": "บรรยาย",
   "text": "อัมพรก็ทำหมดทุกอย่าง ไม่เกี่ยง"
  },
  {
   "t": [
    33.5,
    40.0
   ],
   "who": "บรรยาย",
   "text": "เมื่อน้องๆ เติบโตขึ้น เข้าสู่วัยเรียนประถม และมัธยมกันตามลำดับ"
  },
  {
   "t": [
    40.0,
    46.0
   ],
   "who": "บรรยาย",
   "text": "อัมพรก็เข้าสู่วัยสาว น้องคนรองเรียนแค่มัธยมสาม"
  },
  {
   "t": [
    46.0,
    51.0
   ],
   "who": "บรรยาย",
   "text": "ก็ออกมาช่วยทำงานอีกคน แต่หล่อนทำงานโรงงาน"
  },
  {
   "t": [
    51.0,
    56.0
   ],
   "who": "บรรยาย",
   "text": "ตอนนี้เลยเหลือเพียงน้องสองคนเท่านั้น ที่ยังเรียนประถม"
  },
  {
   "t": [
    56.0,
    64.0
   ],
   "who": "บรรยาย",
   "text": "และกำลังจะขึ้นชั้นมัธยม แต่ตอนนี้ ทางบ้านไม่ได้หากินใช้ไปเพียงวันต่อวันอีกแล้ว"
  },
  {
   "t": [
    64.0,
    70.0
   ],
   "who": "บรรยาย",
   "text": "เพราะเริ่มมีเงินเก็บบ้าง และพ่อกับแม่ก็ยังให้อัมพรเก็บเงินส่วนหนึ่ง"
  },
  {
   "t": [
    70.0,
    74.0
   ],
   "who": "บรรยาย",
   "text": "เอาไว้เป็นของตัวเองด้วย เพราะคิดว่าอีกหน่อย"
  },
  {
   "t": [
    74.0,
    80.0
   ],
   "who": "บรรยาย",
   "text": "อัมพรก็จะต้องแต่งงานมีครอบครัว ก็ควรจะมีเงินทุนเป็นของตนเอง"
  },
  {
   "t": [
    80.0,
    83.72
   ],
   "who": "บรรยาย",
   "text": "เพื่อจะได้สร้างครอบครัวต่อไป"
  }
 ],
