{
 "story": "ชัยชนะของคนไม่ยอมแพ้",
 "part": "4",
 "scene": "บ้านนายชัยยศ",
 "wav": "{DESKTOP}/ชัยชนะของคนไม่ยอมแพ้/เสียงที่ตัดแล้ว/ท่อน4.wav",
 "from": "{DRIVE}/ชัยชนะของคนไม่ยอมแพ้/ฉาก/บ้านนายชัยยศ.iProject",
 "project": "{SAVE}/ชัยชนะของคนไม่ยอมแพ้/ท่อน4_บ้านชัยยศ_20261121.iProject",
 "video": "{VIDEO}/ชัยชนะของคนไม่ยอมแพ้/GPT_ท่อน4_20261121.mp4",
 "lines": [
  {
   "t": [
    0,
    9.36
   ],
   "who": "บรรยาย",
   "text": "เมื่ออัมพรอายุได้ยี่สิบกว่าๆ เธอก็ได้พบรักกับชายหนุ่มคนหนึ่ง ชื่อชัยยศ ซึ่งมีอาชีพค้าขาย"
  },
  {
   "t": [
    9.36,
    17.06
   ],
   "who": "บรรยาย",
   "text": "ทางบ้านของเขามีร้านขายของชำ และเปิดร้านก๋วยเตี๋ยว กับอาหารตามสั่งที่หน้าบ้าน"
  },
  {
   "t": [
    17.06,
    26.26
   ],
   "who": "บรรยาย",
   "text": "ฝั่งฝ่ายชายนั่นก็มีพี่น้องหลายคนเช่นกัน แต่ทั้งบ้านก็เป็นคนขยันขันแข็ง เช่นเดียวกับพ่อแม่ของเธอ"
  },
  {
   "t": [
    26.26,
    33.34
   ],
   "who": "บรรยาย",
   "text": "ดังนั้น แม้ทั้งสองจะมีทุนรอนในการตั้งตัว และสร้างชีวิตคู่ไม่มากนัก"
  },
  {
   "t": [
    33.34,
    40.64
   ],
   "who": "บรรยาย",
   "text": "แต่ทั้งสองก็เชื่อว่าหากขยันทำงาน ก็จะสามารถสร้างอนาคตที่ดีได้อย่างแน่นอน"
  },
  {
   "t": [
    40.64,
    47.7
   ],
   "who": "บรรยาย",
   "text": "ทั้งสองทำงานทั้งค้าขาย และทำงานรับจ้าง จนเก็บเงินได้ก้อนหนึ่ง"
  },
  {
   "t": [
    47.7,
    55.08
   ],
   "who": "บรรยาย",
   "text": "อัมพรก็เห็นลู่ทางในการสร้างฐานะ แม้จะเรียนมาน้อย แต่เธอเป็นคนขยัน"
  },
  {
   "t": [
    55.08,
    62.68
   ],
   "who": "บรรยาย",
   "text": "หมั่นหาความรู้ใหม่ๆ ใส่ตัวเสมอ เธอชอบอ่าน ชอบฟังคนนั้นคนนี้พูด"
  },
  {
   "t": [
    62.68,
    68.12
   ],
   "who": "บรรยาย",
   "text": "ชอบดูข่าวสาร ทั้งจากโทรทัศน์ และอ่านจากหนังสือพิมพ์"
  },
  {
   "t": [
    68.12,
    73.06
   ],
   "who": "บรรยาย",
   "text": "หญิงสาวเห็นว่าตอนนี้ มีหมู่บ้านจัดสรรเกิดขึ้นหลายแห่ง"
  },
  {
   "t": [
    73.06,
    79.42
   ],
   "who": "บรรยาย",
   "text": "เศรษฐกิจโดยรวมของบ้านเมืองก็ดูดี อสังหาริมทรัพย์พวกบ้านคอนโด"
  },
  {
   "t": [
    79.42,
    84.9
   ],
   "who": "บรรยาย",
   "text": "ก็เกิดขึ้นราวกับดอกเห็ด เธอจึงเกิดความคิดที่จะทำอิฐขาย"
  }
 ],
