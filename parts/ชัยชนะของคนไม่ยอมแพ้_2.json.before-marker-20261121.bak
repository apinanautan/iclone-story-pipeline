{
 "story": "ชัยชนะของคนไม่ยอมแพ้",
 "part": "2",
 "scene": "โรงทำอิฐมอญ",
 "wav": "{DESKTOP}/ชัยชนะของคนไม่ยอมแพ้/เสียงที่ตัดแล้ว/ท่อน2.wav",
 "from": "{DRIVE}/ชัยชนะของคนไม่ยอมแพ้/ฉาก/ที่ทำงาน (โรงทำอิฐมอญ).iProject",
 "project": "{SAVE}/ชัยชนะของคนไม่ยอมแพ้/ท่อน2_โรงอิฐ_20261121.iProject",
 "video": "{VIDEO}/ชัยชนะของคนไม่ยอมแพ้/GPT_ท่อน2_20261121.mp4",
 "lines": [
  {
   "t": [
    0.0,
    5.1
   ],
   "who": "บรรยาย",
   "text": "ดูแลน้อง พอน้องสาวคนรองจากเธอโตขึ้นมา"
  },
  {
   "t": [
    5.1,
    10.26
   ],
   "who": "บรรยาย",
   "text": "น้องก็รับหน้าที่ทำงานบ้าน และดูแลน้องต่อไป"
  },
  {
   "t": [
    10.26,
    15.06
   ],
   "who": "บรรยาย",
   "text": "ส่วนอัมพรก็ออกไปช่วยพ่อแม่ทำงานนอกบ้านแทน"
  },
  {
   "t": [
    15.06,
    21.72
   ],
   "who": "บรรยาย",
   "text": "สมัยนั้นยังไม่มีการศึกษาภาคบังคับ ที่ให้เด็กเรียนถึงมัธยมสาม"
  },
  {
   "t": [
    21.72,
    27.9
   ],
   "who": "บรรยาย",
   "text": "ดังนั้นพอจบป.6 อัมพรก็เลยออกมาช่วยพ่อแม่ทำงานเต็มตัว"
  },
  {
   "t": [
    27.9,
    34.4
   ],
   "who": "บรรยาย",
   "text": "งานที่เธอทำ งานแรก คืองานไปช่วยพ่อกับแม่รับจ้างทำอิตมอน"
  },
  {
   "t": [
    34.4,
    40.94
   ],
   "who": "บรรยาย",
   "text": "จากครอบครัวหนึ่ง ซึ่งเป็นกิจการในครอบครัว ไม่ได้ใหญ่โตอะไร"
  },
  {
   "t": [
    40.94,
    46.76
   ],
   "who": "บรรยาย",
   "text": "อัมพรได้เริ่มฝึกช่วยพ่อแม่ ตั้งแต่งานเตรียมดิน หมักดิน"
  },
  {
   "t": [
    46.76,
    52.16
   ],
   "who": "บรรยาย",
   "text": "ที่ต้องผสมดินกับน้ำ ขี้เท่า แกรบ และสาย"
  },
  {
   "t": [
    52.16,
    55.8
   ],
   "who": "บรรยาย",
   "text": "ไปจนถึงการขึ้นรูปปั้นอิต ตากแดดและผึงลม"
  },
  {
   "t": [
    55.8,
    61.3
   ],
   "who": "บรรยาย",
   "text": "มีเพียงงานเผาอิตเท่านั้น ที่เป็นงานที่เธอไม่ได้ช่วย"
  },
  {
   "t": [
    61.3,
    66.82
   ],
   "who": "บรรยาย",
   "text": "เพราะต้องเกี่ยวข้องกับเตาและความร้อน เธอจะไปช่วยพ่อแม่อีกที"
  },
  {
   "t": [
    66.82,
    71.12
   ],
   "who": "บรรยาย",
   "text": "ก็ตอนที่นําอิตที่เย็นแล้ว มาคัดแย่ขนาด"
  },
  {
   "t": [
    71.12,
    76.07
   ],
   "who": "บรรยาย",
   "text": "คัดความสมบูรณ์ของอิต เพื่อเตรียมให้เท่าแก่จํานายต่อไป"
  }
 ],
